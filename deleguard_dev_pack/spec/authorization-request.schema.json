{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deleguard Authorization Request",
  "type": "object",
  "required": [
    "agent",
    "action",
    "resource",
    "operation"
  ],
  "properties": {
    "agent": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "environment": {
          "type": "string"
        }
      }
    },
    "actor": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "type": {
          "enum": [
            "human",
            "service"
          ]
        },
        "delegation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_.:-]{1,127}$"
    },
    "resource": {
      "type": "object",
      "required": [
        "type",
        "id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "attributes": {
          "type": "object"
        },
        "snapshot_hash": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "context": {
      "type": "object"
    },
    "operation": {
      "type": "object",
      "required": [
        "id",
        "hash"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "description": "Stable per intent, preserved across retries; not derived from arguments."
        },
        "hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of canonical execution arguments and target."
        }
      }
    }
  },
  "additionalProperties": false
}
