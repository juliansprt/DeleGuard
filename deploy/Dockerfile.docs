FROM node:22-bookworm-slim AS build
WORKDIR /docs-site
COPY docs-site/package.json docs-site/package-lock.json ./
RUN npm ci
COPY docs-site/ ./
COPY deleguard_dev_pack/spec/openapi.yaml /deleguard_dev_pack/spec/openapi.yaml
RUN npm run build

FROM nginx:1.27-alpine
COPY --from=build /docs-site/dist /usr/share/nginx/html
COPY deploy/docs-nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=3s --retries=8 \
  CMD wget -q -O /dev/null http://127.0.0.1/ || exit 1
