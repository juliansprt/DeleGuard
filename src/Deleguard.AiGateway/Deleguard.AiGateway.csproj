<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Deleguard.AiGateway</RootNamespace>
    <StartupObject>Deleguard.AiGateway.GatewayHost</StartupObject>
    <Description>Client-side OpenAI-compatible PEP: authorizes metadata with Deleguard, routes only on ALLOW, never sends prompts to the SaaS.</Description>
  </PropertyGroup>

</Project>
