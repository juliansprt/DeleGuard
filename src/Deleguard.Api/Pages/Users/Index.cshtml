@page "/users"
@model Deleguard.Api.Pages.Users.IndexModel
@{ ViewData["Title"]="Usuarios"; ViewData["Nav"]="users"; }
<partial name="_PageHeader" model='("Usuarios", "Añade a tu equipo y elige qué puede hacer cada persona en la consola.")' />
<partial name="_Flash" model="new FlashModel(Model.Message,Model.IsError)" />
@if(!string.IsNullOrEmpty(Model.RevealedPassword)){<div class="flash flash-secret" role="status"><strong>@T["Guarda esta contraseña; se muestra una sola vez."]</strong><p class="secret" id="revealed-password">@Model.RevealedPassword</p><button type="button" class="ghost" data-copy data-copy-target="#revealed-password">@T["Copiar"]</button><span>@Model.RevealedEmail</span></div>}
else if(!string.IsNullOrEmpty(Model.RevealedEmail)){<div class="flash flash-ok" role="status">@T["Invitación creada para"] <strong>@Model.RevealedEmail</strong>@T[". Debe iniciar sesión con SSO y ese correo verificado para unirse a la organización."]</div>}
<section class="card"><div class="card-head"><h2>@T["Tu equipo"] <span class="badge neutral">@Model.Users.Count</span></h2>@if(Model.CanWrite){<a class="button" href="#add-user">@T["+ Añadir usuario"]</a>}</div>
@if(Model.Users.Count==0){<p class="muted">@T["Aún no hay usuarios. Añade una persona y selecciona su responsabilidad."]</p>}
else{<div class="table-wrap"><table class="data"><thead><tr><th>@T["Persona"]</th><th>@T["Roles"]</th><th>@T["Estado"]</th><th>@T["Acciones"]</th></tr></thead><tbody>@foreach(var user in Model.Users){<tr><td><strong>@user.DisplayName</strong><div class="hint">@user.Email</div></td><td>@string.Join(", ",user.Roles)</td><td><span class="badge @(user.Enabled ? "allow" : "neutral")">@(user.Enabled ? T["Activo"] : T["Deshabilitado"])</span></td><td>@if(Model.CanWrite){<a href="#user-@user.Id">@T["Editar roles"]</a>@if(user.Enabled){<form method="post" asp-page-handler="Disable"><input type="hidden" name="userId" value="@user.Id" /><button type="submit" class="ghost compact" onclick="return confirm(window.dgText('js.user.disable'));">@T["Deshabilitar"]</button></form>}}</td></tr>}</tbody></table></div>}
</section>
@if(Model.CanWrite){
<details class="card" id="add-user" open="@(Model.IsError && string.IsNullOrEmpty(Model.AssignUserId) ? "open" : null)"><summary data-expand-label="@T["Show"]" data-collapse-label="@T["Hide"]">@T["Añadir una persona al equipo"]</summary><form method="post" asp-page-handler="Create" class="stack" data-busy-form><div class="form-grid"><div><label asp-for="DisplayName">@T["Nombre"]</label><input asp-for="DisplayName" required placeholder="@T["Nombre de la persona"]" /></div><div><label asp-for="Email">@T["Correo electrónico"]</label><input asp-for="Email" type="email" required placeholder="persona@empresa.com" /></div></div><fieldset class="choice-fieldset"><legend>@T["Roles para esta persona"]</legend><p class="hint">@T["Marca los que necesita. Puedes seleccionar varios sin usar atajos de teclado."]</p><div class="role-options">@foreach(var role in Model.Roles){<label class="check-row role-option"><input type="checkbox" name="SelectedRoles" value="@role.Slug" checked="@(Model.SelectedRoles.Contains(role.Slug))" /><span><strong>@role.DisplayName</strong><small class="hint">@role.Slug · @role.Permissions.Count @T["permisos"]</small></span></label>}</div></fieldset><button type="submit" data-busy-label="@T["Añadiendo usuario…"]">@T["Añadir usuario"]</button></form></details>
@foreach(var user in Model.Users){
<details class="card" id="user-@user.Id" open="@(Model.IsError && Model.AssignUserId==user.Id ? "open" : null)"><summary data-expand-label="@T["Show"]" data-collapse-label="@T["Hide"]">@T["Roles de"] @user.DisplayName <span class="hint">· @user.Email</span></summary><form method="post" asp-page-handler="Assign" class="stack" data-busy-form><input type="hidden" name="AssignUserId" value="@user.Id" /><div class="quiet-note" data-role-impact role="status" aria-live="polite"></div><fieldset class="choice-fieldset"><legend>@T["Selecciona los roles que debe conservar"]</legend><div class="role-options">@foreach(var role in Model.Roles){<label class="check-row role-option"><input type="checkbox" name="AssignRoles" data-original="@user.Roles.Contains(role.Slug).ToString().ToLowerInvariant()" data-permissions="@System.Text.Json.JsonSerializer.Serialize(role.Permissions)" value="@role.Slug" checked="@((Model.IsError && Model.AssignUserId==user.Id ? Model.AssignRoles : user.Roles).Contains(role.Slug))" /><span><strong>@role.DisplayName</strong><small class="hint">@role.Slug · @role.Permissions.Count @T["permisos"]</small></span></label>}</div></fieldset><p class="hint">@T["Los roles actuales ya están marcados. Guardar reemplaza la asignación de esta persona por la selección."]</p><button data-busy-label="@T["Guardando roles…"]">@T["Guardar roles de"] @user.DisplayName</button></form></details>
}}
