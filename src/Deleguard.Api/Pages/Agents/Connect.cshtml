@page "/agents/connect"
@model Deleguard.Api.Pages.Agents.ConnectModel
@{ ViewData["Title"]="Conectar agente"; ViewData["Nav"]="agents"; var agent=Model.Agents.FirstOrDefault(a=>a.Id==Model.AgentId); var ready=Model.Coverage.Any(r=>r.AgentEnabled && r.ActionAssigned && r.Policies.Count>0); }
<partial name="_PageHeader" model='("Conecta tu aplicación", "Crea una identidad para tu agente, asígnale una política y comprueba su primera solicitud.")' />
<partial name="_Flash" model="new FlashModel(Model.Message,Model.IsError)" />
@if(Model.PendingApprovalId is not null){<p><a href="/approvals/@Model.PendingApprovalId">@T["Ver revisión administrativa pendiente →"]</a></p>}
<p class="quiet-note">@T["¿Quieres conectar Cursor, VS Code o Claude Code?"] <a href="/ide">@T["IDE Control prepara el agente y sus reglas por ti →"]</a></p>
<ol class="journey-steps"><li class="@(agent is null ? "current" : "complete")"><span class="step-number">1</span><div><strong>@T["Tu agente"]</strong><small>@(agent?.DisplayName ?? T["Nombre y entorno"])</small></div></li><li class="@(ready ? "complete" : agent is not null ? "current" : "")"><span class="step-number">2</span><div><strong>@T["Sus permisos"]</strong><small>@T["Una acción y su política"]</small></div></li><li class="@(Model.HasAuthorization ? "complete" : ready ? "current" : "")"><span class="step-number">@(Model.HasAuthorization ? "✓" : "3")</span><div><strong>@T["Primera solicitud"]</strong><small>@T["Probar y conectar tu código"]</small></div></li></ol>
@if(Model.Secret is not null){<section class="card secret-card"><span class="eyebrow">@T["Se muestra una sola vez"]</span><h2>@T["Guarda la clave del agente"]</h2><p>@T["Tu integración la utilizará para identificarse. Guárdala en un gestor de secretos."]</p><div class="copy-line"><code class="hash" id="connect-key">@Model.Secret</code><button class="ghost" type="button" data-copy data-copy-target="#connect-key">@T["Copiar clave"]</button></div></section>}
@if(Model.Agents.Count>0){<form method="get" class="row project-toolbar"><label for="connect-agent">@T["Continuar con"]</label><select id="connect-agent" name="AgentId"><option value="">@T["Un agente nuevo"]</option>@foreach(var a in Model.Agents){<option value="@a.Id" selected="@(a.Id==Model.AgentId ? "selected" : null)">@a.DisplayName · @a.EnvironmentName</option>}</select><button class="ghost">@T["Abrir"]</button></form>}
@if(agent is null){
<section class="card setup-main"><span class="eyebrow">@T["01 / Identidad"]</span><h2 class="section-title">@T["Dale un nombre a tu agente"]</h2><p>@T["Aplicación seleccionada:"] <strong>@Chrome.CurrentApplication?.Name</strong>.</p>
<form method="post" asp-page-handler="Create" class="stack" data-busy-form><div><label asp-for="DisplayName">@T["Nombre del agente"]</label><input asp-for="DisplayName" required maxlength="120" placeholder="@T["Por ejemplo, asistente de operaciones"]" /></div><div><label asp-for="EnvironmentName">@T["Entorno"]</label><select asp-for="EnvironmentName" required>@foreach(var env in Model.Environments){<option value="@env.Name">@env.Name</option>}</select></div><details class="advanced-options"><summary data-expand-label="@T["Show"]" data-collapse-label="@T["Hide"]">@T["Personalizar el identificador (opcional)"]</summary><label asp-for="ExternalId">@T["Identificador de integración"]</label><input asp-for="ExternalId" placeholder="@T["Se genera a partir del nombre"]" pattern="[a-z][a-z0-9_-]{1,63}" maxlength="64" /><p class="hint">@T["Letras minúsculas, números, guiones o guiones bajos. Lo usarás como agent.id en las solicitudes."]</p></details><button type="submit" data-busy-label="@T["Creando agente…"]">@T["Crear agente y continuar →"]</button></form></section>
}else{
<section class="card"><span class="eyebrow">@T["02 / Permisos"]</span><h2 class="section-title">@T["¿Qué podrá hacer"] @agent.DisplayName?</h2>
@if(ready){<p class="quiet-note">@T["Este agente ya tiene al menos una acción con política publicada. Puedes probarla o asignar más."]</p>}
@if(Model.CanRead("actions.write") && Model.CanRead("policies.write") && Model.AvailablePolicies.Count>0){<form method="post" asp-page-handler="Assign" class="stack" data-busy-form><input type="hidden" asp-for="AgentId" /><label asp-for="PolicyId">@T["Política publicada y su acción"]</label><select asp-for="PolicyId" required><option value="">@T["Elige una política"]</option>@foreach(var policy in Model.AvailablePolicies){<option value="@policy.Id">@policy.Slug · @policy.Action · v@(policy.PublishedVersionNumber)</option>}</select><p class="hint">@T["Conectaremos el agente con la acción y su política. Sus otras asignaciones se conservan."]</p><button data-busy-label="@T["Asignando permisos…"]">@T["Asignar acción y política"]</button></form>}
else{<p>@T["Necesitas una acción registrada y una política publicada antes de autorizar solicitudes."]</p><div class="row">@if(Model.CanRead("actions.read")){<a class="button ghost" href="/actions">@T["1. Registrar acción"]</a>}@if(Model.CanRead("policies.read")){<a class="button ghost" href="/policies">@T["2. Crear política"]</a>}</div>}
@if(Model.CanRead("actions.read") && Model.CanRead("policies.read")){<details class="advanced-options"><summary data-expand-label="@T["Show"]" data-collapse-label="@T["Hide"]">@T["Revisar asignaciones de este agente"]</summary><partial name="_Coverage" model="Model.Coverage" /></details>}</section>
<section class="card"><span class="eyebrow">@T["03 / Primera solicitud"]</span><h2 class="section-title">@T["Prueba las reglas y conecta tu código"]</h2><p>@T["Comprueba la decisión antes de integrar. La consola utiliza este agente sin pedirte su clave."]</p><p><a class="button" href="/playground?AgentId=@agent.Id">@T["Probar con este agente →"]</a></p>
<details class="advanced-options" open><summary data-expand-label="@T["Show"]" data-collapse-label="@T["Hide"]">@T["Integrar con la API"]</summary><p>@T["Antes de ejecutar una operación, llama a"] <code>POST /v1/authorize</code> @T["con la URL de DeleGuard,"] <code>Authorization: Bearer dgk_…</code>, <code>Content-Type: application/json</code> @T["y un"] <code>Idempotency-Key</code> @T["único por operación."]</p><dl class="help-facts"><dt>@T["Identificador del agente"]</dt><dd><code>@agent.ExternalId</code></dd><dt>@T["Entorno"]</dt><dd><code>@agent.EnvironmentName</code></dd></dl><p>@T["Incluye la acción, el recurso, atributos confiables y operation con id estable y hash de los argumentos. Continúa solo ante"] <strong>ALLOW</strong>@T["; ante"] <strong>REQUIRE_APPROVAL</strong>@T[", espera la revisión y consulta la decisión. Ante"] <strong>DENY</strong> @T["o un error, detén la operación."]</p><p>@T["Antes de ejecutar, comprueba de nuevo el recurso y consume el permiso con"] <code>POST /v1/permits/{permitId}/consume</code>. @T["Ejecuta una sola vez y solo si acquired=true. Si el resultado es incierto, investiga antes de iniciar otra operación."]</p><p>@T["Después, reporta execution_id y el resultado con"] <code>POST /v1/executions</code>@T[". Playground no ejecuta operaciones en tu aplicación."]</p></details>
@if(Model.CanRead("audit.read")){<div class="quiet-note">@T["Decisión:"] @(Model.HasAuthorization ? T["recibida"] : T["pendiente"]) @T["· Resultado de ejecución:"] @(Model.HasExecution ? T["reportado"] : T["pendiente"]). <a href="/audit/activity?AgentId=@agent.Id">@T["Ver actividad →"]</a></div>}
<partial name="_CodeExamples" model="Model" />
<p class="hint">@T["AI Gateway y Guard MCP son opcionales. Solo quedan protegidas las operaciones que pasan por tu integración."]</p></section>
}
