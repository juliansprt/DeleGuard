@page "/start"
@model Deleguard.Api.Pages.StartModel
@{ ViewData["Title"]="Inicio rápido"; ViewData["Nav"]="start"; }
<header class="welcome-hero"><div><span class="eyebrow">@T["Tu punto de partida ·"] @Chrome.CurrentApplication?.Name</span><h1>@T["De la idea a tu primera"]<br />@T["acción protegida."]</h1><p>@T["Conecta tu asistente, define sus límites y comprueba el resultado. Empieza por lo que quieres hacer."]</p><a class="text-link" href="#how-it-works">@T["Entender DeleGuard en un minuto ↓"]</a></div><div class="hero-mark" aria-hidden="true"><span>✓</span><small>@T["Decidir · Aprobar · Registrar"]</small></div></header>
<section class="route-grid" aria-label="@T["Elige cómo empezar"]">
@if(Model.RecentProjects.Count>0){<section class="card"><span class="eyebrow">@T["Continue where you left off"]</span><h2>@T["Your recent projects"]</h2><p>@T["Open a saved project to finish its connection or check its latest operation."]</p><div class="stack">@foreach(var project in Model.RecentProjects){<a class="text-link" href="/ide?project=@project.Id">@project.Name →</a>}</div></section>}
@if(Model.Can("agents.read")){<a class="route-card route-primary" href="/ide"><span class="route-icon" aria-hidden="true">⌘</span><span class="eyebrow">@T["Para tu editor"]</span><h2>@T["Conectar mi IDE"]</h2><p>@T["Cursor, VS Code or Claude Code. Download a connection profile and use the portable visual installer."]</p><span class="route-link">@T["Configurar IDE Control →"]</span></a>}
@if(Model.Can("agents.write")){<a class="route-card" href="/agents/connect"><span class="route-icon" aria-hidden="true">&lt;/&gt;</span><span class="eyebrow">@T["Para tu aplicación"]</span><h2>@T["Integrar mi agente"]</h2><p>@T["Añade una comprobación antes de una operación. Conecta tu código con la API de autorización."]</p><span class="route-link">@T["Conectar agente →"]</span></a>}
@if(!Model.Can("agents.write") && Model.Can("approvals.read")){<a class="route-card" href="/approvals"><span class="route-icon" aria-hidden="true">✓</span><span class="eyebrow">@T["Para tu trabajo diario"]</span><h2>@T["Revisar solicitudes"]</h2><p>@T["Comprueba el alcance de una operación y decide si puede continuar."]</p><span class="route-link">@T["Abrir aprobaciones →"]</span></a>}
</section>
<section class="card progress-card"><div class="card-head"><h2>@T["Así va tu aplicación"]</h2><a href="/start">@T["Actualizar estado ↻"]</a></div><p class="hint">@T["El progreso refleja configuración y actividad guardadas, no botones marcados como completados."]</p><ol class="journey-steps compact-journey">
    <li class="@(Model.ConfigurationReady==true ? "complete" : "")"><span class="step-number">1</span><div><strong>@T["Configuración"]</strong><small>@(Model.ConfigurationReady is null ? T["Sin permiso para consultar"] : Model.ConfigurationReady==true ? T["Al menos una acción con agente y política"] : T["Conecta una integración para empezar"])</small></div></li>
    <li class="@(Model.Summary?.AuthorizationTested==true ? "complete" : "")"><span class="step-number">2</span><div><strong>@T["Primera decisión"]</strong><small>@(Model.Summary is null ? T["Sin permiso de auditoría"] : Model.Summary.AuthorizationTested ? T["Solicitud evaluada"] : T["Pendiente de una prueba"])</small></div></li>
    <li class="@(Model.Summary?.ExecutionReported==true ? "complete" : "")"><span class="step-number">3</span><div><strong>@T["Resultado reportado"]</strong><small>@(Model.Summary is null ? T["Sin permiso de auditoría"] : Model.Summary.ExecutionReported ? T["Evidencia recibida de una integración"] : T["Pendiente del reporte de ejecución"])</small></div></li>
</ol></section>
<section id="how-it-works" class="card"><span class="eyebrow">@T["La idea en un minuto"]</span><h2 class="section-title">@T["Tu asistente propone. Tú defines los límites."]</h2><p>@T["Una"] <strong>@T["acción"]</strong> @T["es lo que el agente quiere hacer. Una"] <strong>@T["política"]</strong> @T["decide si puede hacerlo sobre ese recurso. DeleGuard devuelve uno de estos resultados:"]</p><div class="decision-explainer"><article><span class="badge allow">@T["ALLOW · Permitir"]</span><p>@T["La integración puede ejecutar la operación autorizada y reportar su resultado."]</p></article><article><span class="badge wait">@T["REQUIRE_APPROVAL · Revisar"]</span><p>@T["Una persona revisa el alcance antes de que la integración continúe."]</p></article><article><span class="badge deny">@T["DENY · Bloquear"]</span><p>@T["La operación no debe ejecutarse. La decisión explica el motivo."]</p></article></div><p class="hint">@T["Solo se controlan las operaciones que pasan por la integración. AI Gateway, Admin MCP y los webhooks son opcionales para empezar."]</p></section>
<section id="modules"><div class="section-heading"><div><span class="eyebrow">@T["Encuentra tu siguiente paso"]</span><h2 class="section-title">@T["Una guía para cada módulo"]</h2></div><label class="module-search">@T["Buscar en la guía"]<input type="search" data-module-search placeholder="@T["Por ejemplo, claves o aprobación"]" aria-controls="module-directory" /></label></div>
<div id="module-directory" class="module-grid">@foreach(var module in ConsoleGuide.For(HttpContext.GetConsoleUser())){<article class="card module-card" data-module-card><div class="module-heading"><span class="module-symbol" aria-hidden="true">@module.Symbol</span><span class="eyebrow">@T[module.Group]</span></div><h3>@T[module.Title]</h3><p>@T[module.Purpose]</p><details><summary data-expand-label="@T["Show"]" data-collapse-label="@T["Hide"]">@T["Cómo se utiliza"]</summary><ol class="plain-steps">@foreach(var step in module.Steps){<li>@T[step]</li>}</ol><p class="hint">@T[module.Outcome]</p></details><a class="text-link" href="@module.Url">@T["Abrir"] @T[module.Title] →</a></article>}</div><p data-module-empty hidden role="status">@T["No encontramos ese módulo. Prueba con “agentes”, “políticas” o “actividad”."]</p></section>
